{
  "name": "ruee-nocturne",
  "private": true,
  "version": "1.33.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "SINGLE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "shot": "playwright test e2e/shots.spec.ts",
    "lh": "node tools/lighthouse.mjs",
    "store": "tsx tools/store-shots.ts",
    "portraits": "tsx tools/portraits.ts",
    "bestiary": "tsx tools/bestiary.ts",
    "icons": "tsx tools/icons.ts",
    "sim": "tsx tools/sim-cli.ts",
    "bench": "node --expose-gc --import tsx tools/bench.ts",
    "prepare": "simple-git-hooks",
    "assets": "tsx tools/assets/build.ts",
    "audio": "tsx tools/audio/build.ts"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "idb-keyval": "^6.2.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run typecheck && npm test"
  }
}
