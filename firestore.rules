rules_version = '2';
// Règles Firestore (phase 13) : un document de progression par compte, lisible et modifiable par son seul propriétaire ;
// phase 38 : le classement (scores, weeks), lisible par les joueurs connectés.
// Les clés de `progress` sont celles de PROGRESS_KEYS (src/meta/sync.ts) : un test Vitest vérifie qu'elles correspondent.
// Le client ne fait jamais confiance au document (normalizeMeta à la lecture) ; ici on borne la forme et les tailles.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      function me() {
        return request.auth != null && request.auth.uid == uid;
      }
      function p() {
        return request.resource.data.progress;
      }
      // lot L3 : série de jours, clés fermées et toutes présentes, valeurs bornées (src/meta/daily.ts)
      function streakOk(s) {
        return s is map
          && s.keys().hasOnly(['last', 'count', 'best', 'jokerWeek', 'jokerDay'])
          && s.keys().hasAll(['last', 'count', 'best', 'jokerWeek', 'jokerDay'])
          && s.last is string && s.last.size() <= 10
          && s.count is int && s.count >= 0
          && s.best is int && s.best >= 0
          && s.jokerWeek is string && s.jokerWeek.size() <= 8
          && s.jokerDay is string && s.jokerDay.size() <= 10;
      }
      // lot L3 : une mission du jour (k, p, goal, prog, done) ; les règles ne bouclent pas : chaque index est vérifié
      function missionOk(l, i) {
        return l.size() <= i || (l[i] is map && l[i].size() <= 5);
      }
      function missionsOk(ms) {
        return ms is map
          && ms.keys().hasOnly(['date', 'list'])
          && ms.date is string && ms.date.size() <= 10
          && ms.list is list && ms.list.size() <= 3
          && missionOk(ms.list, 0) && missionOk(ms.list, 1) && missionOk(ms.list, 2);
      }
      allow get, delete: if me();
      allow list: if false;
      allow create, update: if me()
        && request.resource.data.keys().hasOnly(['v', 'updatedAt', 'progress'])
        && request.resource.data.v == 1
        && request.resource.data.updatedAt is number
        && p() is map
        && p().keys().hasOnly(['version', 'bestTime', 'bestKills', 'runs', 'totalKills', 'gold', 'goldEarned',
             'shops', 'stats', 'achievements', 'bought', 'character', 'outfits', 'outfit', 'daily', 'slots', 'pseudo',
             'unlocks', 'itemsOff', 'codex', 'chars', 'reveal', 'streak', 'missions', 'friends'])
        && p().achievements is list && p().achievements.size() <= 128
        && p().bought is list && p().bought.size() <= 16
        && p().outfits is list && p().outfits.size() <= 16
        // `shops` (boutique par personnage) a quitté la progression en phase 17 : facultative, sinon toute sauvegarde
        // sans elle était refusée (« Sauvegarde refusée par le serveur », retour de Jimmy, 1.32.1)
        && (!('shops' in p()) || (p().shops is map && p().shops.size() <= 16))
        && p().outfit is map && p().outfit.size() <= 16
        && p().stats is map && p().stats.size() <= 32
        && p().daily is map && p().daily.times is list && p().daily.times.size() <= 10
        // lot L3 : kills de chaque partie du jour, facultatifs (un ancien client ne les écrit pas)
        && (!('kills' in p().daily) || (p().daily.kills is list && p().daily.kills.size() <= 10))
        && p().character is string && p().character.size() <= 32
        && (!('pseudo' in p()) || (p().pseudo is string && p().pseudo.size() <= 16))
        // phase 40 (Bibliothèque) : facultatives, une sauvegarde d'un ancien client ne les a pas
        && (!('unlocks' in p()) || (p().unlocks is list && p().unlocks.size() <= 64))
        && (!('itemsOff' in p()) || (p().itemsOff is list && p().itemsOff.size() <= 64))
        && (!('codex' in p()) || (p().codex is map && p().codex.size() <= 160))
        // phase 41 : stats par personnage (défis par personnage), facultatives
        && (!('chars' in p()) || (p().chars is map && p().chars.size() <= 16))
        // lot L2 : étapes dévoilées (0 à 4), facultatives (un ancien client ne les écrit pas)
        && (!('reveal' in p()) || (p().reveal is int && p().reveal >= 0 && p().reveal <= 4))
        // lot L3 : série de jours et missions du jour (date, 3 missions au plus), facultatives (un ancien client ne
        // les écrit pas), bornées en clés et en valeurs
        && (!('streak' in p()) || streakOk(p().streak))
        && (!('missions' in p()) || missionsOk(p().missions))
        // lot L4 : amis ajoutés par un lien de défi (identifiant et pseudo), 50 au plus, facultatifs (ancien client)
        // relecture : la forme des éléments aussi (identifiant et pseudo), vérifiée sur le premier comme les missions
        && (!('friends' in p()) || (p().friends is list && p().friends.size() <= 50
             && (p().friends.size() == 0 || (p().friends[0] is map && p().friends[0].keys().hasOnly(['uid', 'name'])))));
    }
    // Classement (phase 38, décision de Jimmy) : un document par joueur, ses meilleurs scores (src/meta/board.ts).
    // Lisible par les seuls joueurs connectés, 100 lignes au plus par requête ; chacun n'écrit que le sien, avec des
    // clés fermées, des valeurs bornées (BOARD) et des scores qui ne peuvent que monter. Un client modifié peut
    // toujours tricher dans ces bornes : pas de serveur de jeu (PLAN §1).
    function scoreOk(uid) {
      let d = request.resource.data;
      return request.auth != null && request.auth.uid == uid
        && d.keys().hasOnly(['name', 'char', 'best', 'time', 'kills', 'at'])
        && d.keys().hasAll(['name', 'char', 'best', 'time', 'kills', 'at'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 16
        && d.char is string && d.char.size() <= 32
        && d.best is int && d.best >= 0 && d.best <= 47200
        && d.time is int && d.time >= 0 && d.time <= 7200
        && d.kills is int && d.kills >= 0 && d.kills <= 200000
        && d.at is number
        && (resource == null
          || (d.best >= resource.data.best && d.time >= resource.data.time && d.kills >= resource.data.kills));
    }
    match /scores/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;
      allow create, update: if scoreOk(uid);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /weeks/{week}/scores/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;
      allow create, update: if week.matches('^[0-9]{4}-W[0-9]{2}$') && scoreOk(uid);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Défi du jour entre amis (lot L4, décision de Jimmy) : la meilleure partie du jour d'un joueur connecté avec un
    // pseudo (src/meta/board.ts, DayDoc). Lisible par les seuls joueurs connectés (requête par identifiants, 100 au
    // plus) ; chacun n'écrit que le sien, clés fermées, valeurs bornées (BOARD.dayTimeMax, BOARD.dayKillsMax) et une
    // partie qui ne peut que monter : le temps d'abord, les kills à temps égal. Relecture du lot : le jour écrit est
    // dans une fenêtre de J-2 à J+1 autour de l'heure du serveur (BOARD.dayWindow), et chaque document porte son
    // expiration `x` = début du jour + 7 jours (BOARD.dayTtlDays) : la règle TTL (docs/DEPLOY.md) l'efface ensuite.
    match /days/{day}/scores/{uid} {
      function dayStart() {
        return timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
      }
      function dayOk() {
        let d = request.resource.data;
        return request.auth != null && request.auth.uid == uid
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && dayStart() > request.time - duration.value(3, 'd')
          && dayStart() < request.time + duration.value(1, 'd')
          && d.keys().hasOnly(['name', 'time', 'kills', 'at', 'x'])
          && d.keys().hasAll(['name', 'time', 'kills', 'at', 'x'])
          && d.x is timestamp && d.x == dayStart() + duration.value(7, 'd')
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 16
          && d.time is int && d.time >= 0 && d.time <= 3600
          && d.kills is int && d.kills >= 0 && d.kills <= 20000
          && d.at is number
          && (resource == null
            || d.time > resource.data.time
            || (d.time == resource.data.time && d.kills >= resource.data.kills));
      }
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;
      allow create, update: if dayOk();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Mesure de fréquentation (lot L1, décision de Jimmy) : un document anonyme par appareil qui l'a acceptée, écrit par
    // l'API REST sans compte (src/meta/retention.ts). Clés fermées, cohorte `c` (jours depuis 1970) dans les 31 jours
    // avant la création (jamais dans le futur) puis figée, 31 jours d'ouverture au plus, expiration `x` (règle TTL) à moins de 100 jours. Aucune
    // lecture depuis le jeu : seul Jimmy lit, avec ses droits d'administrateur (`npm run retention`).
    match /retention/{id} {
      function retentionOk() {
        let d = request.resource.data;
        return id.size() == 36
          && d.keys().hasOnly(['c', 'f', 'o', 'x'])
          && d.keys().hasAll(['c', 'f', 'o', 'x'])
          && d.c is int
          && d.f is bool
          && d.o is list && d.o.size() <= 31
          && d.x is timestamp && d.x > request.time && d.x < request.time + duration.value(100, "d");
      }
      allow get, list: if false;
      allow create: if retentionOk()
        // borne basse à 31 jours : un joueur qui accepte hors ligne et ne revient en ligne que plus tard est compté
        // (le client n'écrit plus après J30) ; borne haute à 2 jours : pas de cohorte dans le futur
        && timestamp.value(request.resource.data.c * 86400000) > request.time - duration.value(31, "d")
        && timestamp.value(request.resource.data.c * 86400000) < request.time + duration.value(2, "d");
      allow update: if retentionOk() && request.resource.data.c == resource.data.c;
      allow delete: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
